SELECT 
	E2_FILIAL AS filial,
	E2_PREFIXO AS prefixo,
	E2_NUM AS num_titulo,
	E2_PARCELA AS parcela,
	E2_TIPO AS tipo,
	E2_NATUREZ AS cod_natureza,
	E2_PORTADO AS cod_portador,
	E2_FORNECE AS cod_fornecedor,
	E2_NOMFOR AS fornecedor,
	E2_LOJA AS loja,
	E2_NOMFOR AS fornecedor,
	CONVERT(DATE,E2_EMISSAO) AS dt_emissao,
	CONVERT(DATE,E2_VENCTO) AS dt_vencimento,
	CONVERT(DATE,E2_VENCREA) AS dt_vencimento_real,
	CONVERT(FLOAT,E2_VALOR) AS vl_titulo,
	CONVERT(DATE,E2_BAIXA) AS dt_baixa,
