SELECT TRIM(E2_FILIAL) AS filial,
       TRIM(E2_PREFIXO) AS prefixo,
       TRIM(E2_NUM) AS num_titulo,
       TRIM(E2_PARCELA) AS parcela,
       TRIM(E2_TIPO) AS tipo_titulo,
       TRIM(E2_NATUREZ) AS cod_natureza,
       TRIM(E2_PORTADO) AS cod_portador,
       TRIM(E2_FORNECE) AS cod_fornecedor,
       TRIM(E2_LOJA) AS loja_fornecedor,
       TRIM(CONCAT(TRIM(E2_FORNECE), TRIM(E2_LOJA))) AS cod_forn_loja,
       RTRIM(E2_NOMFOR) AS fornecedor,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_EMISSAO), '')) AS dt_emissao,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCTO), '')) AS dt_vencimento,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCREA), '')) AS dt_vencimento_real,
       TRY_CONVERT(DECIMAL(18, 2), E2_VALOR) AS vl_titulo,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_BAIXA), '')) AS dt_baixa,
       TRIM(E2_BCOPAG) AS banco_de_pagamento,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_EMIS1), '')) AS dt_contabilizacao,
       RTRIM(E2_HIST) AS historico,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_MOVIMEN), '')) AS dt_ult_mov,
       TRIM(E2_OP) AS ordem_producao,
       TRY_CONVERT(DECIMAL(18, 2), E2_SALDO) AS saldo,
       TRY_CONVERT(DECIMAL(18, 2), E2_DESCONT) AS vl_desconto,
       TRY_CONVERT(DECIMAL(18, 2), E2_MULTA) AS vl_multa,
       TRY_CONVERT(DECIMAL(18, 2), E2_JUROS) AS vl_juros,
       TRY_CONVERT(DECIMAL(18, 2), E2_VALLIQ) AS vl_liq_baixa,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCORI), '')) AS dt_vencimento_orig,
       TRY_CONVERT(DECIMAL(9, 4), E2_PORCJUR) AS percent_juros,
       TRIM(E2_NUMBOR) AS num_bordero,
       TRIM(E2_FATPREF) AS pref_fatura,
       TRIM(E2_FATURA) AS num_fatura,
       TRIM(E2_CLASCON) AS classificacao,
       TRIM(E2_RATEIO) AS rateio_cc,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_DTFATUR), '')) AS dt_faturamento,
       TRY_CONVERT(DECIMAL(18, 2), E2_ACRESC) AS vl_acrescimo,
       TRIM(E2_TITORIG) AS num_titulo_orig,
       TRIM(E2_ORIGEM) AS origem_titulo,
       TRIM(E2_FLUXO) AS fluxo_caixa,
       TRIM(E2_ORDPAGO) AS num_ord_pag,
       TRIM(E2_DESDOBR) AS desdobramento,
       TRIM(E2_NUMLIQ) AS num_liquidacao,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_DATALIB), '')) AS dt_liberacao,
       TRIM(E2_CODAPRO) AS cod_aprovador,
       RTRIM(E2_APROVA) AS aprovador,
       TRIM(E2_TIPOFAT) AS tipo_fatura,
       TRY_CONVERT(DECIMAL(18, 2), E2_SDACRES) AS saldo_acrescimo,
       TRY_CONVERT(DECIMAL(18, 2), E2_DECRESC) AS vl_decrescimo,
       TRY_CONVERT(DECIMAL(18, 2), E2_SDDECRE) AS saldo_descrecimo,
       TRIM(E2_USUALIB) AS usuario,
       TRIM(E2_MULTNAT) AS mult_natureza,
       TRIM(E2_MODSPB) AS mod_pag_prev,
       TRY_CONVERT(DECIMAL(18, 2), E2_RETENC) AS vl_retencao,
       TRIM(E2_CONTAD) AS conta_contabil,
       TRIM(E2_FILORIG) AS filial_origem,
       TRIM(E2_SEQBX) AS seq_baixa,
       TRIM(E2_ITEMCTA) AS item_contabil,
       TRIM(E2_MDCONTR) AS num_contrato,
       TRIM(E2_MDPARCE) AS num_parcela,
       TRIM(E2_FORORI) AS fornecedor_original,
       TRIM(E2_LOJORI) AS loja_original,
       TRIM(E2_STATUS) AS status,
       TRIM(E2_TITADT) AS titulo_adto_pa,
       TRIM(E2_TITPAI) AS titulo_pai,
       TRIM(E2_CODAGL) AS cod_aglutinador,
       RTRIM(E2_NOMERET) AS nome_contribuinte,
       TRIM(E2_CNPJRET) AS cnpj_retentor,
       TRIM(E2_INDPRO) AS tipo_processo,
       TRIM(E2_TPESOC) AS tipo_servico,
       TRY_CONVERT(DECIMAL(18, 2), E2_MDMULT) AS multa_contrato,
       TRY_CONVERT(DECIMAL(18, 2), E2_RETCNTR) AS retencao_contrato,
       TRIM(E2_CCUSTO) AS centro_custo,
       TRIM(CONCAT(TRIM(E2_FILIAL), TRIM(E2_CCUSTO))) AS filial_cc,
       TRY_CONVERT(DECIMAL(18, 2), E2_MDDESC) AS desconto_contrato,
       TRY_CONVERT(DECIMAL(18, 2), E2_MDBONI) AS bonificacao_contrato,
       TRIM(E2_PARCAGL) AS parcela_aglutinadora,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_DATAAGE), '')) AS data_agendamento,
       TRIM(E2_CLVL) AS classe_valor,
       TRIM(E2_FATFOR) AS fornecedor_fatura,
       TRIM(E2_IDMOV) AS id_movimento,
       TRIM(E2_STATLIB) AS status_aprovacao,
       TRY_CONVERT(DATE, NULLIF(TRIM(E2_DTBORDE), '')) AS dt_bordero,
       TRIM(E2_TIPOLIQ) AS tipo_liquidacao,
       TRY_CONVERT(DECIMAL(18, 2), E2_VALJUR) AS taxa_permanencia,
       TRIM(E2_FORMPAG) AS forma_pagamento,
       TRIM(E2_NROREF) AS num_ref,
       TRIM(E2_NUMPRO) AS num_proc_ref,
       TRIM(E2_NUMSOL) AS num_solic_transf,
       CASE
           WHEN TRY_CONVERT(DECIMAL(18, 2), E2_SALDO) > 0 THEN 1
           ELSE 0
       END AS flag_saldo_aberto,
       CASE
           WHEN TRY_CONVERT(DECIMAL(18, 2), E2_SALDO) = 0
                AND NULLIF(TRIM(E2_BAIXA), '') IS NOT NULL THEN 1
           ELSE 0
       END AS flag_baixado,
       CASE
           WHEN TRY_CONVERT(DECIMAL(18, 2), E2_SALDO) > 0
                AND NULLIF(TRIM(E2_BAIXA), '') IS NOT NULL THEN 1
           ELSE 0
       END AS flag_baixa_parcial,
       CASE
           WHEN NULLIF(TRIM(E2_PORTADO), '') IS NOT NULL THEN 1
           ELSE 0
       END AS flag_tem_portador,
       CASE
           WHEN NULLIF(TRIM(E2_TITADT), '') IS NOT NULL THEN 1
           ELSE 0
       END AS flag_compensacao_pa,
       CASE
           WHEN NULLIF(TRIM(E2_TITPAI), '') IS NOT NULL THEN 1
           ELSE 0
       END AS flag_titulo_pai,
       DATEDIFF(DAY, TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCORI), '')), TRY_CONVERT(DATE, NULLIF(TRIM(E2_BAIXA), ''))) AS atraso_baixa_dias,
       CASE
           WHEN TRIM(E2_VENCTO) = TRIM(E2_VENCORI) THEN 0
           ELSE 1
       END AS flag_venc_sobrescrito,
       CASE
           WHEN TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCTO), '')) NOT BETWEEN '2015-01-01' AND '2035-12-31' THEN 1
           ELSE 0
       END AS flag_data_implausivel,
       DATEFROMPARTS(YEAR (TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCORI), ''))), MONTH(TRY_CONVERT(DATE, NULLIF(TRIM(E2_VENCORI), ''))), 1) AS competencia_venc_orig
FROM SE2010
WHERE 1 = 1 ;