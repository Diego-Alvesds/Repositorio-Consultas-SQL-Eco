	CONVERT(FLOAT,E2_DESCONT) AS vl_desconto,
	CONVERT(FLOAT,E2_MULTA) AS vl_multa,
	CONVERT(FLOAT,E2_JUROS) AS vl_juros,
	CONVERT(FLOAT,E2_VALLIQ) AS vl_liq_baixa,
	CONVERT(DATE,E2_VENCORI) AS dt_vencimento_orig,
