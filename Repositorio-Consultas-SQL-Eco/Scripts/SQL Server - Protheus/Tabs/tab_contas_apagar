	E2_FLUXO AS fluxo_caixa,
	E2_ORDPAGO AS num_ord_pag,
	CONVERT(DATE,E2_DATALIB) AS dt_liberacao,
	E2_CODAPRO AS cod_aprovador,
	E2_APROVA AS aprovador,
	E2_TIPOFAT AS tipo_fatura,
	CONVERT(FLOAT,E2_SDACRES) AS saldo_acrescimo,
	E2_DECRESC AS decrescimo,
	CONVERT(FLOAT,E2_SDDECRE) AS saldo_descrecimo,
	E2_USUALIB AS usuario,
	E2_MULTNAT AS mult_natureza,
	E2_DIRF AS gera_dirf,
	E2_MODSPB AS mod_pag_prev,
	CONVERT(FLOAT,E2_RETENC) AS vl_retencao,
	E2_CONTAD AS conta_contabil,
	E2_ITEMCTA AS item_contabil,
	E2_LINDIG AS linha_digitavel,
	E2_MDCONTR AS num_contrato,
	E2_MDPARCE AS num_parcela,
	E2_FORORI AS fornecedor_original,
	E2_LOJORI AS loja_original,
	E2_STATUS AS status,
	E2_TITADT AS titulo_adto_pa,
	E2_TITPAI AS titulo_pai,
	E2_CODAGL AS cod_aglutinador,
	E2_NOMERET AS contribuinte,
	E2_CNPJRET AS cnpj_retentor,
	E2_INDPRO AS tipo_processo,
	CONVERT(FLOAT,E2_MDMULT) AS multa_contrato,
	E2_RETCNTR AS retencao_contrato,
	E2_CCUSTO AS centro_custo,
	CONVERT(FLOAT,E2_MDDESC) AS desconto_contrato,
	E2_MDBONI AS bonificacao_contrato,
	E2_PARCAGL AS parcela_aglutinadora,
	E2_CODAPRO AS cod_aprovador,
	CONVERT(DATE,E2_DATAAGE) AS data_agendamento,
	E2_CLVL AS classe_valor,
	E2_FATFOR AS fornecedor_fatura,
	E2_IDMOV AS id_movimento,
	E2_STATLIB AS status_aprovacao,
	CONVERT(DATE,E2_DTBORDE) AS dt_bordero,
	E2_TIPOLIQ AS tipo_liquidacao,
	E2_VALJUR AS taxa_permanencia,
	E2_FORMPAG AS forma_pagamento,
	E2_NROREF AS num_ref,
	E2_NUMPRO AS num_proc_ref
