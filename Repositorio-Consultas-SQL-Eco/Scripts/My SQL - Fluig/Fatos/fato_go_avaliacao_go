-- fato_go_avaliacao_go : 1 linha por proposta que passou por Grandes Obras
WITH ev AS
  (SELECT m30.proposta,
          m30.atividadeDesc AS status_atual,
          CAST(m30.atividade AS SIGNED) AS atividade_cod,
          m30.dataAtualizacao AS dt_atualizacao,
          STR_TO_DATE(m112.dataHistoricoCompleta, '%d/%m/%Y %H:%i:%s') AS dt,
          m112.statusHistoricoDe AS de,
          m112.statusHistorico AS para,
          m112.matriculaUsuarioHistorico AS matricula
   FROM ML001030 m30
   JOIN
     (SELECT DISTINCT COD_REG_LISTA
      FROM DOCUMENTO
      WHERE COD_EMPRESA=1
        AND COD_LISTA=30
        AND VERSAO_ATIVA=1) dd ON dd.COD_REG_LISTA = m30.ID
   JOIN ML001112 m112 ON m112.companyid = m30.companyid
   AND m112.masterid = m30.ID
   WHERE m30.proposta NOT IN ('',
                              '00000NaN')
     AND m30.proposta IS NOT NULL
     AND m30.dataCriacao BETWEEN '2022-01-01 00:00:00' AND '2026-12-31 23:59:59'
     AND (m112.statusHistorico IN ('Avaliar Grandes Obras',
                                   'Repescagem Grandes Obras')
          OR m112.statusHistoricoDe IN ('Avaliar Grandes Obras',
                                        'Repescagem Grandes Obras'))),
     flags AS
  (SELECT proposta,
          status_atual,
          atividade_cod,
          dt_atualizacao,
          dt,
          matricula, -- ENTRADA/REATIVAÇÃO: chegou em Avaliar ou Repescagem vindo de status FORA do GO
 CASE
     WHEN para IN ('Avaliar Grandes Obras',
                   'Repescagem Grandes Obras')
          AND IFNULL(de, '') NOT IN ('Avaliar Grandes Obras',
                                     'Repescagem Grandes Obras',
                                     'Retorno Grandes Obras') THEN 1
     ELSE 0
 END AS entrou, -- RETORNO ao fluxo: saiu de Avaliar para Retorno
 CASE
     WHEN de='Avaliar Grandes Obras'
          AND para='Retorno Grandes Obras' THEN 1
     ELSE 0
 END AS retornou,
 CASE
     WHEN de='Avaliar Grandes Obras'
          AND para='Retorno Grandes Obras'
          AND matricula IN ('andre.pereira',
                            'bruno.silva',
                            'gabriela.martins',
                            'joao.perez',
                            'jose.lima',
                            'marcos.messias',
                            'supermauro',
                            'najara.deus',
                            'richard.rodrigues') THEN 1
     ELSE 0
 END AS retorno_go
   FROM ev),
     agg AS
  (SELECT proposta,
          SUBSTRING_INDEX(GROUP_CONCAT(status_atual
                                       ORDER BY (atividade_cod = 15) ASC, dt_atualizacao DESC SEPARATOR 0x1D), 0x1D, 1) AS status_atual,
          MAX(dt_atualizacao) AS dt_ultima_atualizacao,
          MIN(CASE
                  WHEN entrou=1 THEN dt
              END) AS dt_primeira_entrada,
          MAX(CASE
                  WHEN entrou=1 THEN dt
              END) AS dt_ultima_entrada, -- âncora do ciclo vigente
 MAX(CASE
         WHEN retornou=1 THEN dt
     END) AS dt_ultimo_retorno,
 SUM(entrou) AS qtd_entradas, -- nº de passagens pelo funil (entradas + repescagens)
 SUM(retornou) AS qtd_retornos,
 MAX(retorno_go) AS houve_retorno_go,
 SUBSTRING_INDEX(GROUP_CONCAT(CASE
                                  WHEN retorno_go=1 THEN matricula
                              END
                              ORDER BY dt DESC SEPARATOR '|'), '|', 1) AS matricula_go
   FROM flags
   GROUP BY proposta)
SELECT proposta,
       status_atual,
       dt_ultima_atualizacao,
       CAST(dt_ultima_atualizacao AS DATE) AS data_atualizacao_go,
       dt_primeira_entrada,
       dt_ultima_entrada, -- COORTE = última entrada/reativação; fallback p/ primeira, e p/ atualização se não houver entrada logada
 CAST(COALESCE(dt_ultima_entrada, dt_primeira_entrada, dt_ultima_atualizacao) AS DATE) AS data_entrada_go,
 dt_ultimo_retorno,
 qtd_entradas,
 qtd_retornos,
 houve_retorno_go,
 matricula_go,
 CASE
     WHEN status_atual='Avaliar Grandes Obras' THEN 1
     ELSE 0
 END AS em_avaliacao_agora,
 CASE
     WHEN status_atual='Avaliar Grandes Obras' THEN TIMESTAMPDIFF(DAY, dt_ultima_entrada, NOW())
 END AS aging_fila_dias, -- dias desde a última movimentação (recência real do desfecho)
 TIMESTAMPDIFF(DAY, dt_ultima_atualizacao, NOW()) AS dias_inatividade,
 CASE
     WHEN status_atual='Avaliar Grandes Obras' THEN 'EM_AVALIACAO'
     WHEN houve_retorno_go=1 THEN 'VALIDA'
     WHEN qtd_retornos>0 THEN 'RETORNO_FORA_GRUPO'
     ELSE 'SAIDA_FORA_FLUXO'
 END AS classificacao_go,
 NOW() AS dt_carga
FROM agg;