-- fato_go_avaliacao_go : 1 linha por proposta que passou por Grandes Obras
WITH ev AS
  (SELECT m30.proposta,
          m30.atividadeDesc AS status_atual,
          CAST(m30.atividade AS SIGNED) AS atividade_cod,
          m30.dataAtualizacao AS dt_atualizacao,
          STR_TO_DATE(m112.dataHistoricoCompleta, '%d/%m/%Y %H:%i:%s') AS dt,
          m112.statusHistoricoDe AS de,
          m112.statusHistorico AS para,
          m112.matriculaUsuarioHistorico AS matricula
   FROM ML001030 m30
   JOIN
     (SELECT DISTINCT COD_REG_LISTA
      FROM DOCUMENTO
      WHERE COD_EMPRESA=1
        AND COD_LISTA=30
        AND VERSAO_ATIVA=1) dd ON dd.COD_REG_LISTA = m30.ID
   JOIN ML001112 m112 ON m112.companyid = m30.companyid
   AND m112.masterid = m30.ID
   WHERE m30.proposta NOT IN ('',
                              '00000NaN')
     AND m30.proposta IS NOT NULL
     AND m30.dataCriacao BETWEEN '2022-01-01 00:00:00' AND '2026-12-31 23:59:59'
     AND (m112.statusHistorico IN ('Avaliar Grandes Obras',
                                   'Repescagem Grandes Obras')
          OR m112.statusHistoricoDe IN ('Avaliar Grandes Obras',
                                        'Repescagem Grandes Obras'))),
     flags AS
  (SELECT proposta,
          dt,
          matricula, -- ENTRADA em GO: chegou em Avaliar/Repescagem vindo de fora do trio GO
 CASE
     WHEN para IN ('Avaliar Grandes Obras',
                   'Repescagem Grandes Obras')
          AND IFNULL(de, '') NOT IN ('Avaliar Grandes Obras',
                                     'Repescagem Grandes Obras',
                                     'Retorno Grandes Obras') THEN 1
     ELSE 0
 END AS entrou, -- RETORNO ao fluxo (para classificação): saiu de Avaliar para Retorno
 CASE
     WHEN de='Avaliar Grandes Obras'
          AND para='Retorno Grandes Obras' THEN 1
     ELSE 0
 END AS retornou, -- RETORNO por membro GO (classifica VALIDA)
 CASE
     WHEN de='Avaliar Grandes Obras'
          AND para='Retorno Grandes Obras'
          AND matricula IN ('andre.pereira',
                            'bruno.silva',
                            'gabriela.martins',
                            'joao.perez',
                            'jose.lima',
                            'marcos.messias',
                            'supermauro',
                            'najara.deus',
                            'richard.rodrigues') THEN 1
     ELSE 0
 END AS retorno_go, -- SAÍDA de Avaliar por membro GO (qualquer destino) -> define o RESPONSÁVEL GO
 CASE
     WHEN de='Avaliar Grandes Obras'
          AND matricula IN ('andre.pereira',
                            'bruno.silva',
                            'gabriela.martins',
                            'joao.perez',
                            'jose.lima',
                            'marcos.messias',
                            'supermauro',
                            'najara.deus',
                            'richard.rodrigues') THEN 1
     ELSE 0
 END AS saiu_go
   FROM ev),
     hist AS
  (-- agregados do HISTÓRICO GO (marca passagem + classifica fluxo + tempo)
 SELECT proposta,
        MIN(CASE
                WHEN entrou=1 THEN dt
            END) AS dt_primeira_entrada, -- âncora de coorte
 MAX(CASE
         WHEN entrou=1 THEN dt
     END) AS dt_ultima_entrada,
 MAX(CASE
         WHEN retornou=1 THEN dt
     END) AS dt_ultimo_retorno,
 SUM(entrou) AS qtd_entradas,
 SUM(retornou) AS qtd_retornos,
 MAX(retorno_go) AS houve_retorno_go, -- RESPONSÁVEL GO = último a tirar de Avaliar por membro GO (era retorno_go)
 SUBSTRING_INDEX(GROUP_CONCAT(CASE
                                  WHEN saiu_go=1 THEN matricula
                              END
                              ORDER BY dt DESC SEPARATOR '|'), '|', 1) AS matricula_go
   FROM flags
   GROUP BY proposta),
     viva AS
  (-- registro VIVO da proposta (situação atual = fonte da verdade, independente de GO)
 SELECT proposta,
        status_atual,
        dt_atualizacao
   FROM
     (SELECT m30.proposta,
             m30.atividadeDesc AS status_atual,
             m30.dataAtualizacao AS dt_atualizacao,
             ROW_NUMBER() OVER (PARTITION BY m30.proposta
                                ORDER BY CASE
                                             WHEN m30.atividade='15' THEN 1
                                             ELSE 0
                                         END, m30.dataAtualizacao DESC, m30.ID DESC) AS rn
      FROM ML001030 m30
      JOIN
        (SELECT DISTINCT COD_REG_LISTA
         FROM DOCUMENTO
         WHERE COD_EMPRESA=1
           AND COD_LISTA=30
           AND VERSAO_ATIVA=1) dd ON dd.COD_REG_LISTA = m30.ID
      WHERE m30.proposta NOT IN ('',
                                 '00000NaN')
        AND m30.proposta IS NOT NULL
        AND m30.dataCriacao BETWEEN '2022-01-01 00:00:00' AND '2026-12-31 23:59:59') x
   WHERE rn = 1)
SELECT h.proposta,
       v.status_atual, -- da dim (registro vivo)
 v.dt_atualizacao AS dt_ultima_atualizacao,
 CAST(v.dt_atualizacao AS DATE) AS data_atualizacao_go, -- RECÊNCIA (= dim)
 h.dt_primeira_entrada,
 CAST(h.dt_primeira_entrada AS DATE) AS data_entrada_go, -- COORTE (só GO)
 h.dt_ultima_entrada,
 h.dt_ultimo_retorno,
 h.qtd_entradas,
 h.qtd_retornos,
 h.houve_retorno_go,
 h.matricula_go,
 CASE
     WHEN v.status_atual='Avaliar Grandes Obras' THEN 1
     ELSE 0
 END AS em_avaliacao_agora,
 CASE
     WHEN v.status_atual='Avaliar Grandes Obras' THEN TIMESTAMPDIFF(DAY, h.dt_ultima_entrada, NOW())
 END AS aging_fila_dias,
 TIMESTAMPDIFF(DAY, v.dt_atualizacao, NOW()) AS dias_inatividade,
 CASE
     WHEN v.status_atual='Avaliar Grandes Obras' THEN 'EM_AVALIACAO'
     WHEN h.houve_retorno_go=1 THEN 'VALIDA'
     WHEN h.qtd_retornos>0 THEN 'RETORNO_FORA_GRUPO'
     ELSE 'SAIDA_FORA_FLUXO'
 END AS classificacao_go,
 NOW() AS dt_carga
FROM hist h
JOIN viva v ON v.proposta = h.proposta;